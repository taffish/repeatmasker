<taf-app:container:ghcr.io/taffish/repeatmasker:4.2.4-r1$@[docker/podman: --platform linux/amd64][docker/podman: $(taf_repeatmasker_auto="${TAFFISH_REPEATMASKER_AUTO_MOUNT:-1}"; if test "$taf_repeatmasker_auto" = 0 || test "$taf_repeatmasker_auto" = false || test "$taf_repeatmasker_auto" = FALSE || test "$taf_repeatmasker_auto" = no || test "$taf_repeatmasker_auto" = NO || test "$taf_repeatmasker_auto" = off || test "$taf_repeatmasker_auto" = OFF; then exit 0; fi; taf_repeatmasker_db="${TAFFISH_REPEATMASKER_FAMDB_PATH:-}"; taf_repeatmasker_explicit=0; if test -n "$taf_repeatmasker_db"; then taf_repeatmasker_explicit=1; else for taf_repeatmasker_candidate in "${HOME}/.local/share/taffish/databases/repeatmasker/dfam4" "/usr/local/share/taffish/databases/repeatmasker/dfam4" "/opt/taffish/databases/repeatmasker/dfam4"; do if test -d "$taf_repeatmasker_candidate"; then taf_repeatmasker_db="$taf_repeatmasker_candidate"; break; fi; done; fi; if test -n "$taf_repeatmasker_db" && test -d "$taf_repeatmasker_db"; then taf_repeatmasker_db="$(cd "$taf_repeatmasker_db" 2>/dev/null && pwd -P)"; printf -- '--volume=%s:/opt/RepeatMasker/Libraries/famdb:ro' "$taf_repeatmasker_db"; elif test "$taf_repeatmasker_explicit" = 1; then printf >&2 'taf-repeatmasker: TAFFISH_REPEATMASKER_FAMDB_PATH does not exist or is not a directory: %s\n' "$taf_repeatmasker_db"; fi)][apptainer: $(taf_repeatmasker_auto="${TAFFISH_REPEATMASKER_AUTO_MOUNT:-1}"; if test "$taf_repeatmasker_auto" = 0 || test "$taf_repeatmasker_auto" = false || test "$taf_repeatmasker_auto" = FALSE || test "$taf_repeatmasker_auto" = no || test "$taf_repeatmasker_auto" = NO || test "$taf_repeatmasker_auto" = off || test "$taf_repeatmasker_auto" = OFF; then exit 0; fi; taf_repeatmasker_db="${TAFFISH_REPEATMASKER_FAMDB_PATH:-}"; taf_repeatmasker_explicit=0; if test -n "$taf_repeatmasker_db"; then taf_repeatmasker_explicit=1; else for taf_repeatmasker_candidate in "${HOME}/.local/share/taffish/databases/repeatmasker/dfam4" "/usr/local/share/taffish/databases/repeatmasker/dfam4" "/opt/taffish/databases/repeatmasker/dfam4"; do if test -d "$taf_repeatmasker_candidate"; then taf_repeatmasker_db="$taf_repeatmasker_candidate"; break; fi; done; fi; if test -n "$taf_repeatmasker_db" && test -d "$taf_repeatmasker_db"; then taf_repeatmasker_db="$(cd "$taf_repeatmasker_db" 2>/dev/null && pwd -P)"; printf -- '--bind=%s:/opt/RepeatMasker/Libraries/famdb:ro' "$taf_repeatmasker_db"; elif test "$taf_repeatmasker_explicit" = 1; then printf >&2 'taf-repeatmasker: TAFFISH_REPEATMASKER_FAMDB_PATH does not exist or is not a directory: %s\n' "$taf_repeatmasker_db"; fi)]>
