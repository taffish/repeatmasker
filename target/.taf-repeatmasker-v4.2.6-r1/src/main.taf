<taf-app:container:ghcr.io/taffish/repeatmasker:4.2.6-r1$@[docker/podman: --platform linux/amd64 "$(taf_rm_auto="${TAFFISH_REPEATMASKER_AUTO_MOUNT:-1}"; case "$taf_rm_auto" in 0|false|FALSE|no|NO|off|OFF) printf -- '--env=BLAST_USAGE_REPORT=false'; exit 0;; esac; taf_rm_db="${TAFFISH_REPEATMASKER_FAMDB_PATH:-}"; if test -z "$taf_rm_db"; then for taf_rm_candidate in "${HOME}/.local/share/taffish/databases/repeatmasker/dfam4" "/usr/local/share/taffish/databases/repeatmasker/dfam4" "/opt/taffish/databases/repeatmasker/dfam4"; do if test -e "$taf_rm_candidate" || test -L "$taf_rm_candidate"; then taf_rm_db="$taf_rm_candidate"; break; fi; done; fi; if test -n "$taf_rm_db"; then taf_rm_ok=0; if test -d "$taf_rm_db" && test -s "$taf_rm_db/taffish-famdb.ready" && test -s "$taf_rm_db/taffish-famdb.json" && test -s "$taf_rm_db/dfam40.0.h5"; then taf_rm_db="$(cd "$taf_rm_db" && pwd -P)"; taf_rm_hash="$(if command -v sha256sum >/dev/null 2>&1; then sha256sum "$taf_rm_db/taffish-famdb.sha256"; else shasum -a 256 "$taf_rm_db/taffish-famdb.sha256"; fi)"; taf_rm_hash="${taf_rm_hash%% *}"; if test "$taf_rm_hash" = "$(cat "$taf_rm_db/taffish-famdb.ready")"; then taf_rm_ok=1; fi; fi; case "$taf_rm_db" in *:*|*,*) taf_rm_ok=0;; esac; if test "$taf_rm_ok" = 1; then printf -- '--volume=%s:/opt/RepeatMasker/Libraries/famdb:ro' "$taf_rm_db"; else printf >&2 'taf-repeatmasker: invalid/unprepared FamDB root: %s; use taf-repeatmasker-dfam install in a new empty root, or TAFFISH_REPEATMASKER_AUTO_MOUNT=0 for custom -lib.\n' "$taf_rm_db"; printf -- '--taf-repeatmasker-invalid-resource'; fi; else printf -- '--env=BLAST_USAGE_REPORT=false'; fi)"][apptainer: "$(taf_rm_auto="${TAFFISH_REPEATMASKER_AUTO_MOUNT:-1}"; case "$taf_rm_auto" in 0|false|FALSE|no|NO|off|OFF) printf -- '--env=BLAST_USAGE_REPORT=false'; exit 0;; esac; taf_rm_db="${TAFFISH_REPEATMASKER_FAMDB_PATH:-}"; if test -z "$taf_rm_db"; then for taf_rm_candidate in "${HOME}/.local/share/taffish/databases/repeatmasker/dfam4" "/usr/local/share/taffish/databases/repeatmasker/dfam4" "/opt/taffish/databases/repeatmasker/dfam4"; do if test -e "$taf_rm_candidate" || test -L "$taf_rm_candidate"; then taf_rm_db="$taf_rm_candidate"; break; fi; done; fi; if test -n "$taf_rm_db"; then taf_rm_ok=0; if test -d "$taf_rm_db" && test -s "$taf_rm_db/taffish-famdb.ready" && test -s "$taf_rm_db/taffish-famdb.json" && test -s "$taf_rm_db/dfam40.0.h5"; then taf_rm_db="$(cd "$taf_rm_db" && pwd -P)"; taf_rm_hash="$(if command -v sha256sum >/dev/null 2>&1; then sha256sum "$taf_rm_db/taffish-famdb.sha256"; else shasum -a 256 "$taf_rm_db/taffish-famdb.sha256"; fi)"; taf_rm_hash="${taf_rm_hash%% *}"; if test "$taf_rm_hash" = "$(cat "$taf_rm_db/taffish-famdb.ready")"; then taf_rm_ok=1; fi; fi; case "$taf_rm_db" in *:*|*,*) taf_rm_ok=0;; esac; if test "$taf_rm_ok" = 1; then printf -- '--bind=%s:/opt/RepeatMasker/Libraries/famdb:ro' "$taf_rm_db"; else printf >&2 'taf-repeatmasker: invalid/unprepared FamDB root: %s; use taf-repeatmasker-dfam install in a new empty root, or TAFFISH_REPEATMASKER_AUTO_MOUNT=0 for custom -lib.\n' "$taf_rm_db"; printf -- '--taf-repeatmasker-invalid-resource'; fi; else printf -- '--env=BLAST_USAGE_REPORT=false'; fi)"]>
RepeatMasker ::*ARGV*::
